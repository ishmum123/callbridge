<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textHeaderName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="রহিমা বেগম" />

        <TextView
            android:id="@+id/textHeaderMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="16sp"
            tools:text="01700000099  •  বয়স ২৮  •  নারী  •  ৩ কল" />

        <TextView
            android:id="@+id/textFollowUpBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@android:color/holo_orange_dark"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="@string/label_follow_up_needed"
            android:textColor="@android:color/white"
            android:visibility="gone" />

        <TextView
            style="@style/PatientSectionTitle"
            android:layout_marginTop="20dp"
            android:text="@string/section_summary" />
        <TextView android:id="@+id/textSummaryBn" style="@style/PatientBody" />
        <TextView android:id="@+id/textSummaryEn" style="@style/PatientBody" />

        <TextView
            style="@style/PatientSectionTitle"
            android:layout_marginTop="20dp"
            android:text="@string/section_conditions" />
        <TextView android:id="@+id/textChronicConditions" style="@style/PatientBody" />
        <TextView android:id="@+id/textCurrentSymptoms" style="@style/PatientBody" />

        <TextView
            style="@style/PatientSectionTitle"
            android:layout_marginTop="20dp"
            android:text="@string/section_medications" />
        <TextView android:id="@+id/textMedications" style="@style/PatientBody" />
        <TextView android:id="@+id/textAllergies" style="@style/PatientBody" />

        <TextView
            style="@style/PatientSectionTitle"
            android:layout_marginTop="20dp"
            android:text="@string/section_risk_flags" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupRiskFlags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            style="@style/PatientSectionTitle"
            android:layout_marginTop="20dp"
            android:text="@string/section_advice" />
        <TextView android:id="@+id/textAdviceGiven" style="@style/PatientBody" />
        <TextView android:id="@+id/textFollowUpNote" style="@style/PatientBody" />

        <TextView
            style="@style/PatientSectionTitle"
            android:layout_marginTop="20dp"
            android:text="@string/section_call_history" />

        <LinearLayout
            android:id="@+id/callHistoryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
